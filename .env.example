# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#   cp .env.example .env
# Never commit the real .env — this repo is on GitHub.

# Mita farm advisor (optional; chat degrades gracefully without it)
OPENAI_API_KEY=
OPENAI_MODEL=
SECRET_KEY=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
PIN_LENGTH=4
# AUTH_DB_PATH=   optional; defaults to ./data/users.db
# USE_TLS=1      optional; serve https with a self-signed cert (breaks Google sign-in locally)
