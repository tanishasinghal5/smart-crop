# Copy this file to `.env` and fill in the values. `.env` is gitignored.
#   cp .env.example .env
# Never commit the real .env — this repo is on GitHub.

# Mita farm advisor (optional; chat degrades gracefully without it)
OPENAI_API_KEY=
OPENAI_MODEL=

# data.gov.in / Agmarknet daily mandi prices (optional).
# Get a key at https://data.gov.in — register, then "My Account" > API key.
# Without it, mandi prices stay unverified rather than showing invented numbers.
DATA_GOV_API_KEY=
