# Settings for running server.py on your laptop.
# Copy this file to .env and fill in the values. Never commit .env.
# On Cloud Run these are set on the service instead; the keys come from
# Secret Manager (flask-secret-key, gemini-api-key, maps-server-key).

# --- Login ------------------------------------------------------------------
# Required. Signs the login cookie. Any long random string.
SECRET_KEY=change-me-to-a-long-random-string
# Required for "Sign in with Google". The OAuth client id from Google Cloud.
GOOGLE_CLIENT_ID=
# Optional. How many digits the login PIN has. Default 4.
PIN_LENGTH=4
# Optional. Where accounts are kept: firestore (default) or sqlite.
# firestore survives deploys; sqlite is the emergency fallback.
# AUTH_STORE=firestore
# Optional. The Google Cloud project for Firestore. Default smart-crop-hack.
# GOOGLE_CLOUD_PROJECT=smart-crop-hack
# Optional, sqlite only. Default: ./data/users.db
# AUTH_DB_PATH=

# --- Gemini (soil card, disease advice, chat and advisor) -------------------
# Required for every Gemini feature. From https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. The main model. Pinned so behaviour does not shift before the demo.
# GEMINI_MODEL=gemini-3.8-flash
# Optional. Used when the main model is busy or out of free calls for the day.
# Each model has its own free daily limit. Default gemini-3.7-flash.
# GEMINI_FALLBACK_MODEL=gemini-3.7-flash

# --- Google Maps (village search and GPS to village name) -------------------
# Required for village search. A server key with Places API (New) and
# Geocoding API enabled. Not the browser key.
MAPS_SERVER_KEY=

# --- Earth Engine (Field Health: Sentinel-2 NDVI, CHIRPS rain, ERA5) --------
# Required for satellite data. The Google Cloud project registered for
# Earth Engine. Falls back to GOOGLE_CLOUD_PROJECT when unset. On your laptop,
# also run: earthengine authenticate
# EARTH_ENGINE_PROJECT_ID=your-earth-engine-enabled-project

# --- Local server -----------------------------------------------------------
# Optional. Port for python server.py. Default 8080.
# PORT=8080
# Optional. Serve https with a self-signed certificate (breaks Google sign-in locally).
# USE_TLS=1
